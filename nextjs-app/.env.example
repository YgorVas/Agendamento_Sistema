# Neon PostgreSQL
# `neon deploy` / `neon env pull` write these into .env automatically.
# Runtime connection (pooled endpoint: the host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Migrations/DDL (direct endpoint, no "-pooler")
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional alias accepted by drizzle.config.ts:
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Local Docker alternative (comment the Neon URLs above):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agendamento

# Auth (32+ characters)
AUTH_SECRET=change_this_to_a_random_string_of_at_least_32_bytes

# Optional: WhatsApp Cloud API webhook/chatbot (one company per instance)
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_COMPANY_ID=
WHATSAPP_API_VERSION=
PUBLIC_BASE_URL=https://example.com

# Demo seed
DEMO_PASSWORD=
