# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agendamento

# Auth
AUTH_SECRET=change_this_to_a_random_string_of_at_least_32_bytes
# Define somente quando o proxy confiável substitui o header em toda requisição.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# E-mail exibido na recuperação assistida.
# PILOT_SUPPORT_EMAIL=suporte@example.com

# Optional: WhatsApp Cloud API webhook/chatbot (one company per instance)
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_COMPANY_ID=
WHATSAPP_API_VERSION=
PUBLIC_BASE_URL=https://example.com

# Demo seed
DEMO_PASSWORD=
