# Database
# Local development (docker compose) or Railway public URL for local commands.
# In Railway, set this on the app service from the Postgres service reference:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agendamento

# Auth (32+ characters)
AUTH_SECRET=change_this_to_a_random_string_of_at_least_32_bytes

# Optional: WhatsApp Cloud API webhook/chatbot (one company per instance)
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_COMPANY_ID=
WHATSAPP_API_VERSION=
PUBLIC_BASE_URL=https://example.com

# Demo seed
DEMO_PASSWORD=
